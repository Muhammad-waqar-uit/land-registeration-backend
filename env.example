# ============================================
# Land Registration Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in all values
# cp env.example .env
# ============================================

# ============================================
# Application Configuration
# ============================================
# Port the application will run on
PORT=3000

# Environment: development, production, test
NODE_ENV=development

# ============================================
# Database Configuration (Neon PostgreSQL)
# ============================================
# 
# HOW TO GET THESE VALUES:
# 
# Option 1: Use DATABASE_URL (Recommended - Easiest)
# --------------------------------------------
# 1. Go to: https://neon.tech
# 2. Sign up / Log in
# 3. Create a new project (or use existing)
# 4. Go to Dashboard → Connection Details
# 5. Copy the "Connection string" (pooler recommended)
# 6. Paste it below (replace [PASSWORD] with your actual password if needed)
#
DATABASE_URL=postgresql://[USERNAME]:[PASSWORD]@[HOST]/[DATABASE]?sslmode=require

# Option 2: Use Individual Fields (Alternative)
# --------------------------------------------
# If you prefer individual fields instead of DATABASE_URL:
# 1. From Neon Dashboard → Connection Details
# 2. Copy each value separately:
#
# DB_HOST=[HOST_FROM_NEON]
# DB_PORT=5432
# DB_USERNAME=[USERNAME_FROM_NEON]
# DB_PASSWORD=[PASSWORD_FROM_NEON]
# DB_DATABASE=[DATABASE_NAME_FROM_NEON]

# Legacy Support (for backward compatibility)
# If you're migrating from Supabase, these will work too:
# SUPABASE_DB_HOST=[HOST]
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USERNAME=[USERNAME]
# SUPABASE_DB_PASSWORD=[PASSWORD]
# SUPABASE_DB_DATABASE=[DATABASE]

# ============================================
# JWT Authentication Configuration
# ============================================
# 
# HOW TO GET THESE VALUES:
# 
# JWT_SECRET:
# -----------
# Generate a strong random secret key:
#   On Linux/Mac: openssl rand -base64 32
#   On Windows: Use online generator or PowerShell:
#     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# 
# IMPORTANT: Use a STRONG random secret in production!
# Never commit this secret to version control.
#
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration time
# Format: number + unit (s=seconds, m=minutes, h=hours, d=days)
# Examples: 1h, 24h, 7d, 30d
JWT_EXPIRES_IN=7d

# ============================================
# Email Configuration (Gmail SMTP)
# ============================================
# 
# HOW TO GET THESE VALUES:
# 
# Step 1: Enable 2-Step Verification
# ----------------------------------
# 1. Go to: https://myaccount.google.com/security
# 2. Scroll to "How you sign in to Google"
# 3. Click "2-Step Verification"
# 4. Follow prompts to enable it (requires phone)
#
# Step 2: Generate App Password
# ------------------------------
# 1. Go to: https://myaccount.google.com/apppasswords
#    (If link doesn't work, enable 2-Step Verification first)
# 2. Select:
#    - App: Mail
#    - Device: Other (Custom name)
#    - Name: Land Register Backend
# 3. Click "Generate"
# 4. Copy the 16-character password (e.g., "abcd efgh ijkl mnop")
# 5. Remove ALL spaces: "abcdefghijklmnop"
#
# Step 3: Add to .env
# -------------------
# Use your Gmail address and the app password (no spaces!)
#
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=abcdefghijklmnop
EMAIL_FROM=your-email@gmail.com

# Frontend URL (for password reset links)
# This is where users will be redirected after clicking reset link
# Change to your actual frontend URL in production
FRONTEND_URL=http://localhost:3000

# ============================================
# Development Mode (Email Service)
# ============================================
# 
# If you don't want to set up Gmail right now:
# - Leave EMAIL_* variables empty or don't set them
# - The system will log emails to console instead
# - Password reset tokens will be returned in API response (dev only)
# 
# This is fine for development/testing!

# ============================================
# CORS Configuration
# ============================================
# Allowed origins for CORS (comma-separated)
# Leave empty or set to "*" to allow all origins
# In production, specify your frontend domain(s)
#
# Example: CORS_ORIGIN=http://localhost:3000,https://yourdomain.com
#
# Note: Currently set to allow all origins (origin: true in code)
# CORS_ORIGIN=

# ============================================
# File Storage Configuration
# ============================================
# Files are stored locally in the 'uploads' directory
# No additional configuration needed
# 
# Uploaded files will be accessible at:
# http://localhost:3000/uploads/[bucket]/[filename]
#
# Example: http://localhost:3000/uploads/land-documents/1234567890-document.pdf

# ============================================
# Quick Setup Checklist
# ============================================
# 
# ✅ Copy this file to .env
# ✅ Set DATABASE_URL (from Neon dashboard)
# ✅ Generate and set JWT_SECRET
# ✅ (Optional) Set up Gmail for email service
# ✅ Set FRONTEND_URL to your frontend URL
# ✅ Run: npm install
# ✅ Run: npm run start:dev
# ✅ Test: http://localhost:3000/api/docs
#
# ============================================
# Troubleshooting
# ============================================
#
# Database Connection Issues:
# - Verify DATABASE_URL is correct (copy from Neon dashboard)
# - Check password is URL-encoded if it has special characters
# - Ensure SSL mode is set: ?sslmode=require
#
# Email Issues:
# - See GMAIL_SETUP.md for detailed setup
# - See GMAIL_TROUBLESHOOTING.md for common errors
# - Run: node check-email-config.js to verify configuration
#
# JWT Issues:
# - Ensure JWT_SECRET is set and is a strong random string
# - Check JWT_EXPIRES_IN format is correct (e.g., 7d, 24h)
#
# ============================================
# Security Notes
# ============================================
#
# ⚠️  NEVER commit .env file to version control
# ⚠️  Use strong, random secrets in production
# ⚠️  Rotate JWT_SECRET periodically
# ⚠️  Use HTTPS in production
# ⚠️  Keep app passwords secure (revoke if compromised)
#
# ============================================
