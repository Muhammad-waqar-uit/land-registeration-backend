# ============================================
# Land Registration Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in all values
# cp env.example .env
# ============================================

# ============================================
# Application Configuration
# ============================================
# Port the application will run on
PORT=3000

# Environment: development, production, test
NODE_ENV=development

# ============================================
# Database Configuration (Neon PostgreSQL)
# ============================================
# 
# HOW TO GET THESE VALUES:
# 
# Option 1: Use DATABASE_URL (Recommended - Easiest)
# --------------------------------------------
# 1. Go to: https://neon.tech
# 2. Sign up / Log in
# 3. Create a new project (or use existing)
# 4. Go to Dashboard → Connection Details
# 5. Copy the "Connection string" (pooler recommended)
# 6. Paste it below (replace [PASSWORD] with your actual password if needed)
#
DATABASE_URL=postgresql://[USERNAME]:[PASSWORD]@[HOST]/[DATABASE]?sslmode=require

# Option 2: Use Individual Fields (Alternative)
# --------------------------------------------
# If you prefer individual fields instead of DATABASE_URL:
# 1. From Neon Dashboard → Connection Details
# 2. Copy each value separately:
#
# DB_HOST=[HOST_FROM_NEON]
# DB_PORT=5432
# DB_USERNAME=[USERNAME_FROM_NEON]
# DB_PASSWORD=[PASSWORD_FROM_NEON]
# DB_DATABASE=[DATABASE_NAME_FROM_NEON]

# Legacy Support (for backward compatibility)
# If you're migrating from Supabase, these will work too:
# SUPABASE_DB_HOST=[HOST]
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USERNAME=[USERNAME]
# SUPABASE_DB_PASSWORD=[PASSWORD]
# SUPABASE_DB_DATABASE=[DATABASE]

# ============================================
# JWT Authentication Configuration
# ============================================
# 
# HOW TO GET THESE VALUES:
# 
# JWT_SECRET:
# -----------
# Generate a strong random secret key:
#   On Linux/Mac: openssl rand -base64 32
#   On Windows: Use online generator or PowerShell:
#     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# 
# IMPORTANT: Use a STRONG random secret in production!
# Never commit this secret to version control.
#
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration time
# Format: number + unit (s=seconds, m=minutes, h=hours, d=days)
# Examples: 1h, 24h, 7d, 30d
JWT_EXPIRES_IN=7d

# ============================================
# Wallet Configuration (HD Wallet)
# ============================================
# 
# HOW TO GET THESE VALUES:
# 
# MASTER_WALLET_MNEMONIC:
# -----------------------
# This is the master seed phrase for generating user wallet addresses.
# 
# IMPORTANT SECURITY NOTES:
# - Store this mnemonic securely (never commit to git!)
# - If you lose this mnemonic, you cannot recover user wallets
# - Each user gets a unique wallet address derived from this master
# - The master wallet controls all derived addresses
# 
# Option 1: Generate a new mnemonic (First time setup)
# ----------------------------------------------------
# 1. Start the application without MASTER_WALLET_MNEMONIC set
# 2. The system will generate a new mnemonic and log it
# 3. Copy the mnemonic from the logs
# 4. Add it to your .env file as MASTER_WALLET_MNEMONIC
# 5. Restart the application
# 
# Option 2: Use an existing mnemonic
# -----------------------------------
# If you already have a master mnemonic, paste it here:
# (Must be 12 or 24 words, space-separated)
#
# Example format:
# MASTER_WALLET_MNEMONIC=word1 word2 word3 ... word12
#
# Leave empty for first-time generation (will be logged on startup)
MASTER_WALLET_MNEMONIC=

# ============================================
# Blockchain Configuration (Required for Blockchain Integration)
# ============================================
# 
# HOW TO GET THESE VALUES:
# 
# BLOCKCHAIN_RPC_URL:
# -------------------
# This is used to interact with the blockchain and smart contract.
# 
# Option 1: Use a public RPC endpoint (Free but rate-limited)
# -----------------------------------------------------------
# Ethereum Mainnet: https://eth.llamarpc.com
# Polygon: https://polygon.llamarpc.com
# Arbitrum: https://arb1.arbitrum.io/rpc
# 
# Option 2: Use Alchemy/Infura (Recommended for production)
# ---------------------------------------------------------
# 1. Sign up at https://alchemy.com or https://infura.io
# 2. Create a new app/project
# 3. Get your RPC URL (looks like: https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY)
# 4. Paste it below
# 
# Example:
# BLOCKCHAIN_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
#
BLOCKCHAIN_RPC_URL=

# SMART_CONTRACT_ADDRESS:
# ----------------------
# The deployed smart contract address for LandRegistryUpgradeable
# This is the address where your contract is deployed on the blockchain
# 
# Example:
# SMART_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
#
SMART_CONTRACT_ADDRESS=

# BLOCKCHAIN_ADMIN_PRIVATE_KEY:
# -----------------------------
# Private key of the admin wallet that has DEFAULT_ADMIN_ROLE in the smart contract
# This wallet will be used to call contract functions (registerLand, etc.)
# 
# IMPORTANT SECURITY NOTES:
# - NEVER commit this private key to version control!
# - Store this securely (use environment variables or secret management)
# - This wallet must have ETH/tokens for gas fees
# - This wallet must have DEFAULT_ADMIN_ROLE in the smart contract
# 
# How to get:
# 1. Create a new wallet or use existing admin wallet
# 2. Export the private key (without 0x prefix or with, both work)
# 3. Make sure this wallet has admin role in the contract
# 4. Fund it with native tokens for gas fees
# 
# Example:
# BLOCKCHAIN_ADMIN_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
# or
# BLOCKCHAIN_ADMIN_PRIVATE_KEY=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
#
BLOCKCHAIN_ADMIN_PRIVATE_KEY=

# LEDGER_CONTRACT_ADDRESS (LandLedgerLite – points & payment recording):
# -----------------------------------------------------------------------
# Set after deploying contracts/LandLedgerLite.sol.
# Deploy with constructor(adminAddress); use same wallet as BLOCKCHAIN_ADMIN_PRIVATE_KEY.
# If not set, ledger/points features are disabled.
# Example: LEDGER_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
#
LEDGER_CONTRACT_ADDRESS=

# ============================================
# Email Configuration (Gmail SMTP)
# ============================================
# 
# HOW TO GET THESE VALUES:
# 
# Step 1: Enable 2-Step Verification
# ----------------------------------
# 1. Go to: https://myaccount.google.com/security
# 2. Scroll to "How you sign in to Google"
# 3. Click "2-Step Verification"
# 4. Follow prompts to enable it (requires phone)
#
# Step 2: Generate App Password
# ------------------------------
# 1. Go to: https://myaccount.google.com/apppasswords
#    (If link doesn't work, enable 2-Step Verification first)
# 2. Select:
#    - App: Mail
#    - Device: Other (Custom name)
#    - Name: Land Register Backend
# 3. Click "Generate"
# 4. Copy the 16-character password (e.g., "abcd efgh ijkl mnop")
# 5. Remove ALL spaces: "abcdefghijklmnop"
#
# Step 3: Add to .env
# -------------------
# Use your Gmail address and the app password (no spaces!)
#
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=abcdefghijklmnop
EMAIL_FROM=your-email@gmail.com

# Frontend URL (for password reset links)
# This is where users will be redirected after clicking reset link
# Change to your actual frontend URL in production
FRONTEND_URL=http://localhost:3000

# ============================================
# Development Mode (Email Service)
# ============================================
# 
# If you don't want to set up Gmail right now:
# - Leave EMAIL_* variables empty or don't set them
# - The system will log emails to console instead
# - Password reset tokens will be returned in API response (dev only)
# 
# This is fine for development/testing!

# ============================================
# CORS Configuration
# ============================================
# Allowed origins for CORS (comma-separated)
# Leave empty or set to "*" to allow all origins
# In production, specify your frontend domain(s)
#
# Example: CORS_ORIGIN=http://localhost:3000,https://yourdomain.com
#
# Note: Currently set to allow all origins (origin: true in code)
# CORS_ORIGIN=

# ============================================
# File Storage Configuration
# ============================================
# Files are stored locally in the 'uploads' directory
# No additional configuration needed
# 
# Uploaded files will be accessible at:
# http://localhost:3000/uploads/[bucket]/[filename]
#
# Example: http://localhost:3000/uploads/land-documents/1234567890-document.pdf

# ============================================
# IPFS Configuration (Pinata)
# ============================================
# 
# HOW TO GET THESE VALUES:
# 
# PINATA_JWT:
# -----------
# This is your Pinata JWT token for IPFS file uploads.
# 
# Option 1: Use provided JWT token
# --------------------------------
# If you have a JWT token from Pinata, paste it here:
# PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# Option 2: Generate new JWT from Pinata
# ---------------------------------------
# 1. Go to: https://pinata.cloud
# 2. Sign up / Log in
# 3. Go to API Keys section
# 4. Create a new API key with appropriate permissions
# 5. Copy the JWT token
# 6. Paste it below
#
# IMPORTANT: Keep your JWT token secure!
# Never commit this token to version control.
#
# Leave empty if you don't want IPFS uploads (files will only be stored locally)
PINATA_JWT=

# PINATA_GATEWAY (Optional):
# --------------------------
# Your Pinata gateway domain (e.g., "your-gateway.mypinata.cloud")
# If not set, defaults to "gateway.pinata.cloud"
# 
# You can find your gateway domain in your Pinata dashboard
# Leave empty to use the default public gateway
PINATA_GATEWAY=

# ============================================
# Quick Setup Checklist
# ============================================
# 
# ✅ Copy this file to .env
# ✅ Set DATABASE_URL (from Neon dashboard)
# ✅ Generate and set JWT_SECRET
# ✅ (Optional) Set up Gmail for email service
# ✅ Set FRONTEND_URL to your frontend URL
# ✅ Run: npm install
# ✅ Run: npm run start:dev
# ✅ Test: http://localhost:3000/api/docs
#
# ============================================
# Troubleshooting
# ============================================
#
# Database Connection Issues:
# - Verify DATABASE_URL is correct (copy from Neon dashboard)
# - Check password is URL-encoded if it has special characters
# - Ensure SSL mode is set: ?sslmode=require
#
# Email Issues:
# - See GMAIL_SETUP.md for detailed setup
# - See GMAIL_TROUBLESHOOTING.md for common errors
# - Run: node check-email-config.js to verify configuration
#
# JWT Issues:
# - Ensure JWT_SECRET is set and is a strong random string
# - Check JWT_EXPIRES_IN format is correct (e.g., 7d, 24h)
#
# ============================================
# Security Notes
# ============================================
#
# ⚠️  NEVER commit .env file to version control
# ⚠️  Use strong, random secrets in production
# ⚠️  Rotate JWT_SECRET periodically
# ⚠️  Use HTTPS in production
# ⚠️  Keep app passwords secure (revoke if compromised)
#
# ============================================
